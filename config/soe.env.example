# Corporate SOE launcher settings.
# Copy to ~/.config/corporate-soe/soe.env on your Mac and fill in the values.

# --- Where the image lives (ECR) ---
SOE_REGISTRY=123456789012.dkr.ecr.ap-southeast-2.amazonaws.com
SOE_REPOSITORY=corporate-dev-soe
# "stable" follows the centrally promoted version; or pin e.g. 1.0.0
SOE_TAG=stable

# --- AWS (used to pull from ECR and, for Bedrock, to call Claude) ---
SOE_AWS_PROFILE=soe-dev
SOE_AWS_REGION=ap-southeast-2

# --- How Claude Code reaches the model ---
#   bedrock   : Amazon Bedrock using the AWS profile above (recommended for corporate)
#   anthropic : Claude account login (/login) or ANTHROPIC_API_KEY
SOE_MODEL_PROVIDER=bedrock
# Optional: pin a Bedrock model / inference profile
# SOE_ANTHROPIC_MODEL=

# --- Sandbox options ---
# 1 = default-deny outbound network except allowed-domains.txt
SOE_FIREWALL=0
# 1 = forward your Mac's SSH agent into the container (for git over SSH)
SOE_FORWARD_SSH=1
# Extra domains to allow when the firewall is on (comma-separated)
SOE_EXTRA_DOMAINS=
